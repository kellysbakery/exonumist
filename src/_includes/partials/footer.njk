<footer class="footer">
  <div class="shell footer-inner">
    <div class="footer-note">
      <p>{{ site.siteName }}.com is an independent collector resource focused on New York City token history.</p>
      <p>Corrections, additions, and attribution requests are welcome.</p>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      {% for item in navigation.footer %}
        <a href="{{ item.url }}">{{ item.label }}</a>
      {% endfor %}
    </nav>
  </div>
</footer>
