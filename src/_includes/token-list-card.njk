<a
  class="card-link"
  href="{{ tokenCardUrl }}"
  {% if tokenCardFilterable %}
    data-collection-token-card
    data-status="{{ tokenCardToken.catalogStatus or tokenCardToken.status }}"
    data-search="{{ tokenCardSearchText | default('') | escape }}"
  {% endif %}>
  <article class="card token-list-card">
    <div class="token-list-card-media">
      {% set imagePath = "" %}
      {% if tokenCardToken | hasTokenThumb("o") %}
        {% set imagePath = tokenCardToken | tokenThumbPath("o") %}
      {% elif tokenCardToken | hasTokenImage("o") %}
        {% set imagePath = tokenCardToken | tokenImagePath("o") %}
      {% endif %}

      {% if imagePath %}
        {% set imageForm = tokenCardToken.form %}
        {% set imageAlt = tokenCardToken.displayId ~ " obverse" %}
        {% set imageClass = "token-list-card-image" %}
        {% set frameClassPrefix = "token-list-card-media-frame" %}
        {% include "shaped-image.njk" %}
      {% else %}
        {% set tokenPlaceholderClass = "token-list-card-placeholder" %}
        {% include "token-placeholder.njk" %}
      {% endif %}
    </div>

    <div class="token-list-card-body">
      <span class="token-card-id">
        {{ tokenCardToken.displayId }}
      </span>

      <strong class="token-list-card-title">
        {{ tokenCardToken.title }}
      </strong>

      {% if tokenCardToken.counterstamp %}
        <p class="token-list-card-variant">
          {{ tokenCardToken.counterstamp }} Counterstamp
        </p>
      {% endif %}

      {% set tokenCardDescription = tokenCardDescription or tokenDetailView.buildDisplayDescription(tokenCardToken, { lookups: lookups }) %}
      {% if tokenCardDescription %}
        <p class="token-list-card-desc">
          {{ tokenCardDescription }}
        </p>
      {% endif %}

      {% set tokenCardMetaParts = tokenDetailView.buildCardMetaParts(tokenCardToken, { lookups: lookups }) %}
      <div class="token-card-meta-row">
        <p class="token-list-card-meta">
          {% for part in tokenCardMetaParts %}
            {% if not loop.first %}· {% endif %}{{ part }}
          {% endfor %}
        </p>
      </div>
    </div>

  </article>
</a>
