---
layout: base.njk
title: Search the Collection
description: Search the collection by catalog number, borough, material, token text, group, collecting area, and type.
permalink: /search/index.html
---

<section class="section">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span>/</span>
    <span>Search</span>
  </nav>

  <h1>Search the Collection</h1>
  <p class="section-intro">
    Search the collection by catalog number, borough, material, token text, group, or collecting area.
  </p>

  <div class="card browse-controls">
    <div class="browse-search-group">
      <label class="sr-only" for="browse-search">Search tokens</label>
      <input
        type="text"
        id="browse-search"
        class="browse-search-input"
        placeholder="Search by catalog number, borough, material, token text, group, or area..." />
    </div>

    <div class="browse-filter-group" data-filter-group="borough">
      <div class="browse-filter-heading">
        <strong>Borough</strong>
        <button type="button" class="browse-group-action" data-action="all" data-filter="borough">All boroughs</button>
      </div>

      <div class="browse-chip-row">
        {% for item in browseView.filters.boroughs %}
          <button type="button" class="browse-chip is-active" data-filter="borough" data-value="{{ item }}" aria-pressed="true">
            <span>{{ item }}</span>
            <span class="browse-chip-count">0</span>
          </button>
        {% endfor %}
      </div>
    </div>

    <div class="browse-filter-group" data-filter-group="type">
      <div class="browse-filter-heading">
        <strong>Type</strong>
        <button type="button" class="browse-group-action" data-action="all" data-filter="type">All types</button>
      </div>

      <div class="browse-chip-row">
        {% for item in browseView.filters.types %}
          <button type="button" class="browse-chip is-active" data-filter="type" data-value="{{ item }}" aria-pressed="true">
            <span>{{ lookups.type[item] }}</span>
            <span class="browse-chip-count">0</span>
          </button>
        {% endfor %}
      </div>
    </div>

    <div class="browse-summary">
      <strong id="browse-count"></strong>
      <button type="button" id="browse-reset">Reset filters</button>
    </div>
  </div>

  <div id="browse-grid" class="grid-3 browse-grid">
  {% for token in browseView.tokens %}
    <article
      class="card browse-card"
      data-borough="{{ token.borough }}"
      data-types="{{ token.browseTypes | join(' ') }}"
      data-search="{{ token.searchText }}">
      <a class="card-link browse-card-link" href="{{ token.url or '/' }}?from=search">
        <div class="browse-card-media">
          {% set browseImagePath = "" %}
          {% if token | hasTokenThumb("o") %}
            {% set browseImagePath = token | tokenThumbPath("o") %}
          {% elif token | hasTokenImage("o") %}
            {% set browseImagePath = token | tokenImagePath("o") %}
          {% endif %}

          {% if browseImagePath %}
            {% set imagePath = browseImagePath %}
            {% set imageAlt = token.displayId %}
            {% set imageForm = token.form %}
            {% set imageClass = "token-list-card-image" %}
            {% set plainImageClass = "" %}
            {% set frameClassPrefix = "token-list-card-media-frame" %}
            {% include "shaped-image.njk" %}
          {% else %}
            {% set tokenPlaceholderClass = "browse-card-placeholder" %}
            {% include "token-placeholder.njk" %}
          {% endif %}
        </div>

        <div class="browse-card-body">
          <span class="token-card-id">{{ token.displayId }}</span>

          <p class="browse-card-title">{{ token.title }}</p>

          <div class="token-card-meta-row browse-card-meta-row">
            <p class="meta browse-card-meta">
              {{ token.borough }} · {{ lookups.type[token.type] }}
            </p>
          </div>
        </div>
      </a>
    </article>
  {% endfor %}
</div>
</section>
<script src="/assets/js/browse.js" defer></script>
